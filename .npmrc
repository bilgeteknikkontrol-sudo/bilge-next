; Kurulum sirasinda devDependencies ATLANMASIN.
;
; Hostinger gibi kendi sunucusunda derleyen ortamlar NODE_ENV=production ile
; `npm install` calistirdiginda npm devDependencies'i atlar. Bu projede
; typescript, tailwindcss ve @tailwindcss/postcss orada duruyor; atlanirsa
; `next build` "Cannot find module" ile duser. Hata kurulum adiminda degil
; derleme adiminda ciktigi icin sebebi de anlasilmaz.
production=false
omit=
